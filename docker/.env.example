# minty-onboarding-web — local environment.
# Copy to `.env` (in this docker/ folder) before running docker compose:
#   cp .env.example .env
#
# All values below are safe local defaults. The orchestrator overrides these
# when running the full stack together. Both are inlined at build time
# (next.config.ts `env`): in a deployed environment LEAVE THEM SET — an unset
# value is inlined as the localhost default.

# Petty Cash (the Minty Flask app): /auth/email/*, /legal/*, /xero_auth,
# /xero_connect, /logout, /entity, and any /api/onboarding/* path not routed to
# the onboarding API. Unset falls back to http://localhost:8010 (lib/flaskBase.ts).
PETTY_CASH_URL=http://localhost:8010

# The extracted onboarding API (the Django service, ../minty-onboarding-api).
# Which service answers which path is decided in one place -- lib/apiRoutes.ts.
# Unset falls back to http://localhost:8030, which is what the service's docker
# image and `manage.py runserver` both use.
ONBOARDING_API_URL=http://localhost:8030
