{
  "name": "minty-onboarding-web",
  "version": "0.1.0",
  "private": true,
  "prettier": "@minty/shared/prettier",
  "scripts": {
    "dev": "next dev -p 3030",
    "dev:poke": "node scripts/dev-poke.mjs",
    "dev:clean": "node -e \"require('fs').rmSync('.next/dev',{recursive:true,force:true})\" && next dev -p 3030",
    "build": "next build",
    "start": "next start -p 3030",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:routes": "vitest run lib/__tests__/apiRoutes.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@minty/shared": "github:minty-oliveandvine/minty-shared-ts#v0.7",
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "material-symbols": "^0.48.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
